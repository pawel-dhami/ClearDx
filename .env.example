# Copy to .env.local and fill in.
# With GROQ_API_KEY set, predictions come from the hosted language model; without it, from the
# model trained on public data in ml/ (see the /model page).
# Optional: force an engine with PREDICTOR=llm, ml or mock (rule-based demo).
PREDICTOR=
GROQ_API_KEY=
GROQ_MODEL=
# Optional: Supabase Auth (magic link + Google) and saved history.
# Leave empty to run without accounts (no Sign in button). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to true once the Google provider is configured in Supabase (shows the Google button).
NEXT_PUBLIC_AUTH_GOOGLE=
