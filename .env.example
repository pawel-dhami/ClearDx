# Copy to .env.local and fill in. With no GROQ_API_KEY the app runs in mock mode.
GROQ_API_KEY=
# Optional: Groq model id (default: openai/gpt-oss-120b)
GROQ_MODEL=
# Optional: force a predictor: "mock" or "groq" (default: groq if key present, else mock)
PREDICTOR=
# Optional: Supabase Auth (magic link + Google) and saved history.
# Leave empty to run without accounts (no Sign in button). The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to true once the Google provider is configured in Supabase (shows the Google button).
NEXT_PUBLIC_AUTH_GOOGLE=
